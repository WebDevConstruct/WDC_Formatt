// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

 enum Status {
  PROCESSING
  COMPLETED
  FAILED
}
//enum TypoGraphy {
 // BOLD
 // UNDERLINE
//}

// 2. LOBBY AREA: Student Profiles
//The Expired At for now should be removed as the 30 days set is system set, not user customised
model User {
  clerkId         String    @id @map("clerk_id")
  email           String
  username        String   @unique // <--- Add this "Surgical" anchor
  university      String?   @default("University")
  department      String
  planTier        String?   @default("free") @map("plan_tier")
  expiresAt       DateTime? @map("access_expires_at")
  generationsUsed Int       @default(0) @map("generation_used")
  isWaitlisted    Boolean   @default(true) @map("is_waitlisted")
  createdAt       DateTime? @default(now()) @map("created_at")

  // Relationships
  
  generations       Generation[]
  @@map("user")
}

// 3. THE 3-PAGE REPORT: Document Schema
model Generation {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String?  @map("student_id")
  title              String?  @default("New Document")
  prompt             String
  intent             String
  relateToDepartment Boolean? @default(true) @map("relate_to_department")
  formatting         Json     // Prisma handles jsonb as Json
  refinementCount    Int?     @default(0) @map("refinement_count")
  maxRefinements     Int?     @default(3) @map("max_refinements")
  isCurrent          Boolean? @default(true) @map("is_current")
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at")
  generatedContent String   @db.Text  // <--- This saves the raw AI text
  status            Status


  // Relations
user                 User? @relation(fields: [studentId], references : [clerkId])
  @@map("generations")
 
}

// 4. WAITLIST: Phase 1 Access Control
model Waitlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  isClaimed Boolean? @default(false) @map("is_claimed")
  createdAt DateTime? @default(now()) @map("created_at")

  @@map("waitlist")
}



